{
  "manifest_version": 3,
  "name": "ParkSite — Bonos Rápidos",
  "version": "1.0.0",
  "description": "Autocompletado ultrarrápido de formularios de bonos mediante abreviaturas (/1, /2...) integrado con ParkSite.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ParkSite — Bonos Rápidos",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.bonoparques.es/*",
    "*://*.parquewarner.com/*",
    "*://*.parquedeatracciones.es/*",
    "*://*.faunia.es/*",
    "*://*.zoo.es/*",
    "*://*.aquopolis.es/*",
    "*://localhost/*",
    "*://127.0.0.1/*",
    "https://*.github.io/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://localhost/*",
        "*://127.0.0.1/*",
        "https://*.github.io/*",
        "file:///*"
      ],
      "js": ["content-script-park.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.bonoparques.es/*",
        "*://*.parquewarner.com/*",
        "*://*.parquedeatracciones.es/*",
        "*://*.faunia.es/*",
        "*://*.zoo.es/*",
        "*://*.aquopolis.es/*",
        "<all_urls>"
      ],
      "js": ["content-script-bonos.js"],
      "run_at": "document_idle"
    }
  ]
}

